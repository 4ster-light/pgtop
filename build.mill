//| mill-version: 1.3.1
//| mill-jvm-version: 21

package build

import mill.*, scalalib.*, javalib.*

/** Dependency versions, pinned in one place. */
object Versions:
  val scala: String = "3.7.4"
  val munit: String = "1.3.6"
  val postgresql: String = "42.7.14"
  val circe: String = "0.14.17"
  val testcontainers: String = "1.21.4"
  val slf4j: String = "2.0.17"

/** Strict compiler settings shared by every main and test module. */
object Settings:
  val scalac: Seq[String] = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-Wunused:all",
    "-Werror",
    "-Xsemanticdb"
  )

/** Configuration shared by main and test modules. */
trait PgtopLint extends ScalaModule:
  /** Repository root as seen from this module; no filesystem access at task time. */
  def repositoryRoot: os.Path

  def scalacOptions = Settings.scalac

trait PgtopModule extends PgtopLint:
  def scalaVersion = Versions.scala

  def repositoryRoot = moduleDir / os.up

trait PgtopTests extends ScalaModule.ScalaTests0, TestModule.Munit, PgtopLint:
  def scalaVersion = Versions.scala

  /** Test modules live one level deeper: `<root>/<module>/test`. */
  def repositoryRoot = moduleDir / os.up / os.up

  def mvnDeps = Seq(mvn"org.scalameta::munit:${Versions.munit}")

/** Domain model: snapshots, findings, severity. No dependencies, no IO. */
object core extends PgtopModule:
  def mvnDeps = Seq()

  object test extends PgtopTests:
    def moduleDeps = Seq(core)

/** JDBC collection of PostgreSQL statistics. Knows nothing about findings. */
object collector extends PgtopModule:
  def moduleDeps = Seq(core)
  def mvnDeps = Seq(mvn"org.postgresql:postgresql:${Versions.postgresql}")

  object test extends PgtopTests:
    def moduleDeps = Seq(collector)

/** Pure rules: snapshot -> findings. */
object heuristics extends PgtopModule:
  def moduleDeps = Seq(core)
  def mvnDeps = Seq()

  object test extends PgtopTests:
    def moduleDeps = Seq(heuristics)

/** Optional EXPLAIN (ANALYZE, FORMAT JSON) runner for top offenders. */
object explain extends PgtopModule:
  def moduleDeps = Seq(core, collector)
  def mvnDeps = Seq(
    mvn"io.circe::circe-parser:${Versions.circe}",
    mvn"io.circe::circe-core:${Versions.circe}"
  )

/** Snapshot files: JSON round-trip of a captured snapshot. Knows no JDBC. */
object store extends PgtopModule:
  def moduleDeps = Seq(core)
  def mvnDeps = Seq(
    mvn"io.circe::circe-core:${Versions.circe}",
    mvn"io.circe::circe-parser:${Versions.circe}"
  )

  object test extends PgtopTests:
    def moduleDeps = Seq(store)

/** Rendering: terminal and Markdown. Pure, does not know JDBC. */
object report extends PgtopModule:
  def moduleDeps = Seq(core)
  def mvnDeps = Seq()

  object test extends PgtopTests:
    def moduleDeps = Seq(report)

/** Entry point: argument parsing, wiring, exit codes. */
object cli extends PgtopModule:
  def moduleDeps = Seq(core, collector, heuristics, explain, report, store)
  def mvnDeps = Seq()
  def mainClass = Some("pgtop.cli.Main")

  object test extends PgtopTests:
    def moduleDeps = Seq(cli)

/** Integration tests: a throwaway PostgreSQL started through testcontainers. */
object itest extends PgtopModule:
  def moduleDeps = Seq(core, collector, heuristics, explain, report, store, cli)
  def mvnDeps = Seq()

  object test extends PgtopTests:
    def moduleDeps = Seq(itest)
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.testcontainers:postgresql:${Versions.testcontainers}",
      mvn"org.postgresql:postgresql:${Versions.postgresql}",
      mvn"org.slf4j:slf4j-simple:${Versions.slf4j}"
    )

/** Repository-wide formatting and linting.
  *
  * Both tools run once over the whole tree: scalafix resolves its own classpath
  * and would otherwise start a dozen coursier processes that fight over the
  * cache lock.
  */
object lint extends Module:
  private val ignoredDirectories = Set("out", ".git", ".bsp", ".bloop", ".metals", "result")

  private val repositoryRoot = moduleDir / os.up

  private val scalafmtConfig = (repositoryRoot / ".scalafmt.conf").toString

  private val scalafixConfig = (repositoryRoot / ".scalafix.conf").toString

  /** scalafix 0.14 parses Scala 3 syntax; the 0.12 build in nixpkgs does not. */
  private val scalafixBinary =
    sys.env.getOrElse("SCALAFIX_BIN", (repositoryRoot / "scripts" / "scalafix").toString)

  /** Both tools run without a classpath: the enabled rules are syntactic. */
  private val scalaVersion = Versions.scala

  /** Every Scala file in the repository, `build.mill` included. Only called from
    * command bodies: a cached task may only read declared sources, a command may
    * look at the working tree.
    */
  private def scalaSourcePaths(): Seq[os.Path] =
    val walked = os.walk(repositoryRoot, skip = path => ignoredDirectories.contains(path.last))
    walked.filter(path => path.ext == "scala" || path.last == "build.mill")

  private def allScalaFiles(): Seq[String] = scalaSourcePaths().map(_.toString)

  private def runScalafmt(write: Boolean, files: Seq[String]): Unit =
    val arguments =
      if write then Seq("--config", scalafmtConfig) ++ files
      else Seq("--test", "--config", scalafmtConfig) ++ files
    val result = os.proc("scalafmt", arguments).call(check = false, stdout = os.Inherit, stderr = os.Inherit)
    if result.exitCode != 0 then
      if write then throw new RuntimeException("scalafmt failed")
      else throw new RuntimeException("scalafmt found files that need formatting; run `mill lint.fmt`")

  private def runScalafix(files: Seq[String], fix: Boolean): Unit =
    val arguments =
      (if fix then Seq.empty else Seq("--check")) ++
        Seq("--syntactic", "--scala-version", scalaVersion, "--config", scalafixConfig) ++ files
    val result =
      os.proc(
        "bash",
        scalafixBinary,
        arguments
      ).call(cwd = repositoryRoot, check = false, stdout = os.Inherit, stderr = os.Inherit)
    if result.exitCode != 0 then
      if fix then throw new RuntimeException(s"scalafix could not rewrite the sources (exit ${result.exitCode})")
      else throw new RuntimeException(s"scalafix found code to rewrite (exit ${result.exitCode}); run `mill lint.fix`")

  /** Rewrites sources in place. */
  def fmt() = Task.Command {
    runScalafmt(write = true, files = allScalaFiles())
  }

  /** Fails when any file needs formatting. */
  def fmtCheck() = Task.Command {
    runScalafmt(write = false, files = allScalaFiles())
  }

  /** Fails when scalafix would rewrite anything. */
  def fixCheck() = Task.Command {
    runScalafix(files = allScalaFiles(), fix = false)
  }

  /** Rewrites every module with scalafix. */
  def fix() = Task.Command {
    runScalafix(files = allScalaFiles(), fix = true)
  }

  /** The CI gate: formatting and linting, both check-only. */
  def check() = Task.Command {
    runScalafmt(write = false, files = allScalaFiles())
    runScalafix(files = allScalaFiles(), fix = false)
  }
